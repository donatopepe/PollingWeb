<?xml version="1.0"?>
<!--
  ============================================================================
  Web.config.example — modello commentato per la modalità legacy ASP.NET / IIS
  ============================================================================
  Copiare in `Web.config` e sostituire i placeholder, oppure lasciare `Web.config`
  con i placeholder e fornire i valori come variabili d'ambiente al processo IIS.

  Riferimento: docs/CONFIGURATION.md · docs/INSTALL.md (sezione legacy IIS)
  ============================================================================
-->
<configuration>

  <!--
    Sezione di configurazione dello scheduler Quartz.NET.
    Il tipo dichiarato deve restare invariato: è un gestore NameValue nativo.
  -->
  <configSections>
    <section name="quartz" type="System.Configuration.NameValueSectionHandler, System, Version=1.0.5000.0,Culture=neutral, PublicKeyToken=b77a5c561934e089"/>
  </configSections>

  <quartz>
    <!-- Nome logico dello scheduler: identifica l'istanza nel job store. -->
    <add key="quartz.scheduler.instanceName" value="ServerQuartzScheduler"/>

    <!-- Pool di thread dei job. -->
    <add key="quartz.threadPool.type" value="Quartz.Simpl.SimpleThreadPool, Quartz"/>
    <add key="quartz.threadPool.threadCount" value="10"/>

    <!-- Millisecondi oltre i quali un trigger mancato è considerato "misfire". -->
    <add key="quartz.jobStore.misfireThreshold" value="60000"/>

    <!--
      Job store ADO su SQL Server: i job e i trigger sopravvivono al riavvio.
      Le tabelle QRTZ_* sono create dallo script `sql/quartz-schema.sql`.
    -->
    <add key="quartz.jobStore.type" value="Quartz.Impl.AdoJobStore.JobStoreTX, Quartz"/>
    <add key="quartz.jobStore.tablePrefix" value="QRTZ_"/>
    <add key="quartz.jobStore.dataSource" value="myDS"/>

    <!--
      Connessione al database Quartz.
      Provider ADO.NET: SqlServer-20 per .NET Framework, SqlServer per Quartz 3.x / .NET 8.
    -->
    <add key="quartz.dataSource.myDS.connectionString"
         value="Data Source=${POLLING_DB_SERVER};Initial Catalog=Quartz;User Id=${POLLING_DB_USER};$1=[REDACTED];"/>
    <add key="quartz.dataSource.myDS.provider" value="SqlServer-20"/>
  </quartz>

  <appSettings>
    <!-- SMTP values can also be provided through the matching POLLING_SMTP_* environment variables. -->
    <add key="POLLING_SMTP_HOST" value="${POLLING_SMTP_HOST}"/>
    <add key="POLLING_SMTP_PORT" value="587"/>
    <add key="POLLING_SMTP_ENABLE_SSL" value="true"/>
    <add key="POLLING_SMTP_USE_DEFAULT_CREDENTIALS" value="false"/>
    <add key="POLLING_SMTP_USERNAME" value="${POLLING_SMTP_USERNAME}"/>
    <add key="POLLING_SMTP_PASSWORD" value="${POLLING_SMTP_PASSWORD}"/>
  </appSettings>

  <connectionStrings>
    <!--
      Database eProcurement: contiene i dati di acquisto letti/scritti dal polling.
      Usato da sp_Flusso_RDA, sp_Esiti_Ordini_SAP, Tbl_Export_SAP_OnLine, ecc.
    -->
    <add name="PollingEprocurement"
         connectionString="Server=${POLLING_DB_SERVER};Database=eProcurement;UID=${POLLING_DB_USER};$1=[REDACTED];"
         providerName="System.Data.SqlClient"/>

    <!-- Database applicativo: TaskService, LogTaskService, TargetSC00G100, DimProcessi, ... -->
    <add name="PollingConnectionString"
         connectionString="Server=${POLLING_DB_SERVER};Database=Polling;UID=${POLLING_DB_USER};$1=[REDACTED];"
         providerName="System.Data.SqlClient"/>

    <!-- Variante usata da System.Data.SqlClient diretto (sintassi in minuscolo supportata). -->
    <add name="PollingConnectionStringDirect"
         connectionString="data source=${POLLING_DB_SERVER};initial catalog=Polling;user id=${POLLING_DB_USER};$1=[REDACTED];"/>
  </connectionStrings>

  <system.web>
    <!--
      In produzione: debug="false".
      In sviluppo: debug="true" per gli stack trace dettagliati.
    -->
    <compilation targetFramework="4.5" debug="true"/>
    <httpRuntime targetFramework="4.5"/>
    <!--
      In produzione usare RemoteOnly o On.
      mode="Off" espone i dettagli delle eccezioni anche ai client remoti.
    -->
    <customErrors mode="Off"/>
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear/>
        <!-- Pagina di ingresso dell'applicazione. -->
        <add value="Home.aspx"/>
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
