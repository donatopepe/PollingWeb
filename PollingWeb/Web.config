<?xml version="1.0"?>
<!--
  ============================================================================
  PollingWeb — configurazione applicazione (modalità legacy ASP.NET / IIS)
  ============================================================================
  ⚠️  QUESTO FILE NON CONTIENE E NON DEVE CONTENERE SEGRETI REALI.
      Le credenziali sono placeholder ${...} da risolvere al momento del deploy
      (variabili d'ambiente o sostituzione del file).

  Placeholder usati
  =================
    ${POLLING_DB_SERVER}      host o istanza SQL Server
    ${POLLING_DB_USER}        login applicativo (privilegi minimi)
    ${POLLING_DB_PASSWORD}    password del login applicativo
    ${POLLING_SMTP_HOST}      server SMTP per le notifiche

  Modello completo e commentato: Web.config.example
  Documentazione:                docs/CONFIGURATION.md
  ============================================================================
-->
<configuration>
  <configSections>
    <section name="quartz" type="System.Configuration.NameValueSectionHandler, System, Version=1.0.5000.0,Culture=neutral, PublicKeyToken=b77a5c561934e089"/>
  </configSections>

  <!-- Scheduler Quartz: job store ADO su SQL Server (database dedicato). -->
  <quartz>
    <add key="quartz.scheduler.instanceName" value="ServerQuartzScheduler"/>
    <add key="quartz.threadPool.type" value="Quartz.Simpl.SimpleThreadPool, Quartz"/>
    <add key="quartz.threadPool.threadCount" value="10"/>
    <add key="quartz.jobStore.misfireThreshold" value="60000"/>
    <add key="quartz.jobStore.type" value="Quartz.Impl.AdoJobStore.JobStoreTX, Quartz"/>
    <add key="quartz.jobStore.tablePrefix" value="QRTZ_"/>
    <add key="quartz.jobStore.dataSource" value="myDS"/>
    <add key="quartz.dataSource.myDS.connectionString" value="Data Source=${POLLING_DB_SERVER};Initial Catalog=Quartz;User Id=${POLLING_DB_USER};$1=[REDACTED];"/>
    <add key="quartz.dataSource.myDS.provider" value="SqlServer-20"/>
  </quartz>

  <appSettings>
    <add key="smtpServer" value="${POLLING_SMTP_HOST}"/>
  </appSettings>

  <connectionStrings>
    <add name="PollingEprocurement" connectionString="Server=${POLLING_DB_SERVER};Database=eProcurement;UID=${POLLING_DB_USER};$1=[REDACTED];" providerName="System.Data.SqlClient"/>
    <add name="PollingConnectionString" connectionString="Server=${POLLING_DB_SERVER};Database=Polling;UID=${POLLING_DB_USER};$1=[REDACTED];" providerName="System.Data.SqlClient"/>
    <add name="PollingConnectionStringDirect" connectionString="data source=${POLLING_DB_SERVER};initial catalog=Polling;user id=${POLLING_DB_USER};$1=[REDACTED];"/>
  </connectionStrings>

  <system.web>
    <compilation targetFramework="4.5" debug="true"/>
    <httpRuntime targetFramework="4.5"/>
    <customErrors mode="Off"/>
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear/>
        <add value="Home.aspx"/>
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
<!--ProjectGuid: cf3864c1-ba67-4d53-a7d7-3b3ed5e8fbd3-->
