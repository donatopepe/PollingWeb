<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  Database — configurazione (modalità legacy .NET Framework)
  ============================================================================
  ⚠️  QUESTO FILE NON CONTIENE E NON DEVE CONTENERE SEGRETI REALI.
      I valori sono placeholder ${...} da risolvere al deploy.

  Placeholder usati
  =================
    ${POLLING_DB_SERVER}      host o istanza SQL Server
    ${POLLING_DB_USER}        login applicativo (privilegi minimi)
    ${POLLING_DB_PASSWORD}    password del login applicativo

  Modello commentato: app.config.example
  Documentazione:     docs/CONFIGURATION.md
  ============================================================================
-->
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <!--
          Le chiavi sono generate da Database/Properties/Settings.settings:
          il nome deve restare `Database.Properties.Settings.<NomeImpostazione>`
          perché System.Configuration le risolvi per nome completo.
        -->
        <add name="Database.Properties.Settings.PollingConnectionString"
            connectionString="Server=${POLLING_DB_SERVER};Database=Polling;User Id=${POLLING_DB_USER};$1=[REDACTED];"
            providerName="System.Data.SqlClient" />
        <add name="Database.Properties.Settings.eProcurementConnectionString"
            connectionString="Server=${POLLING_DB_SERVER};Database=eProcurement;User Id=${POLLING_DB_USER};$1=[REDACTED];"
            providerName="System.Data.SqlClient" />
    </connectionStrings>
    <startup>
        <!-- Target della libreria: .NET Framework 4.5 (legacy). -->
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5"/>
    </startup>
</configuration>
