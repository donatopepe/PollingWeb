<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Progetto SDK-style multi-target (task X1.2).
    Il target net48 conserva la compatibilita' con l'applicazione WebForms legacy;
    net8.0 e' il target cross-platform. Entrambi si compilano su qualunque sistema
    operativo grazie a Microsoft.NETFramework.ReferenceAssemblies, che fornisce gli
    assembly di riferimento di .NET Framework senza richiedere Windows (fatto P14).

    L'ordine dei target conta: il primo (net48) e' quello usato quando il progetto
    viene referenziato da un progetto che non specifica un target.
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <AssemblyName>Database</AssemblyName>
    <RootNamespace>Database</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!--
      SYSLIB0051: proviene solo da Database/dtsTabelle.Designer.cs, il DataSet tipizzato
      generato dal designer, che usa i costruttori di serializzazione basati su formatter
      (obsoleti da .NET 8). Non e' codice nostro e non si corregge a mano: rigenerarlo
      richiede Visual Studio su Windows. La soppressione e' limitata a questo progetto e
      documentata qui; il ridisegno del livello dati e' compito del task C2.
    -->
    <NoWarn>$(NoWarn);SYSLIB0051</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!--
      Su .NET Framework questo assembly non e' implicito e il SDK-style project non lo
      aggiunge: senza, `System.ComponentModel.DataAnnotations` non si risolve (CS0234).
      Su .NET 8 appartiene al framework condiviso e non serve.
    -->
    <Reference Include="System.ComponentModel.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <!-- Assembly di riferimento di .NET Framework: permettono il target net48 su Linux -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Un solo provider dati per entrambi i target (ADR 0004 §1) -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- ApplicationSettingsBase e ConfigurationManager per net8.0 -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Il DataSet tipizzato: dtsTabelle.Designer.cs e' generato da dtsTabelle.xsd.
      Il file .xsd resta nel repository per poter rigenerare il designer, ma non
      viene incorporato come risorsa: il designer contiene gia' lo schema inline.
    -->
    <None Update="dtsTabelle.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>dtsTabelle.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </None>
    <Compile Update="dtsTabelle.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>dtsTabelle.xsd</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
