  <!--
    Variabili sqlcmd usate dagli script in Security\\.
    La password NON ha default: va obbligatoriamente fornita al deploy
    (es. `sqlcmd -v PollingAppPassword="..."`), altrimenti la creazione del login
    fallisce per policy invece di creare un account con password vuota.
  -->
  <ItemGroup>
    <SqlCmdVariable Include="PollingAppLogin">
      <Value>PollingApp</Value>
      <DefaultValue>PollingApp</DefaultValue>
    </SqlCmdVariable>
    <SqlCmdVariable Include="PollingAppPassword">
      <Value></Value>
      <DefaultValue></DefaultValue>
    </SqlCmdVariable>
  </ItemGroup>
