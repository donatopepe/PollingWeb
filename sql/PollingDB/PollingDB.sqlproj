    <!--
      RDA_Esiti_LastOutput_OnLine e Tbl_Export_SAP_OnLine NON appartengono a questo
      database: sono state spostate in ..\..\sql\eProcurement\dbo\Tables\
      (task T0.12). Evidenza: le procedure di questo progetto le referenziano sempre
      come eProcurement.dbo.*, e i TableAdapter che le usano ottengono la connessione
      con new DatabaseInfo(true), cioe' quella di eProcurement.
      Vedi docs/adr/0001-sql-schema-source-of-truth.md §4 (A2).
    -->
    <Build Include="dbo\Views\ViewTaskService.sql">
