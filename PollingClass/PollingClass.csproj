<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PollingClass — logica di dominio (task X1.3).

    Target UNICO net48 in questa fase. Il multi-target net48;net8.0 è X1.3c e richiede
    prima X1.3b (estrazione delle classi Quartz dai servizi ASMX) e i successivi porting
    degli endpoint che dipendono da System.Web.Services. Quartz 3.x è ora il provider del
    job store persistente (task X2.2), ma il target net8 resta bloccato dagli ASMX legacy.

    Perché SDK-style già ora: il csproj classico dichiarava v4.5 senza targeting pack,
    quindi il progetto non si compilava su nessun sistema che non fosse Windows con il
    Developer Pack (MSB3644, fatto P14). Con Microsoft.NETFramework.ReferenceAssemblies
    la build è riproducibile su Linux, macOS e Windows.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PollingClass</AssemblyName>
    <RootNamespace>PollingClass</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <!-- Non genera un file di configurazione: la config arriva dall'applicazione ospite -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assembly di riferimento di .NET Framework: build su qualunque sistema operativo -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Un solo provider dati, come in Database (ADR 0004 §1) -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <!-- Quartz 3.x: JobStoreTX persistente su SQL Server, task X2.2 -->
    <PackageReference Include="Quartz" Version="3.13.1" />
    <PackageReference Include="Quartz.Serialization.Json" Version="3.13.1" />
    <!-- Lettura/scrittura XLSX: cross-platform, MIT. Sostituisce la precedente
         dipendenza XLSX (LGPL, Windows-only) rimossa in X1.3. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.7.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- API web e servizi SOAP legacy: presenti solo su .NET Framework (fatto P3) -->
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Services" />
    <!-- Non implicito nei progetti SDK-style (fatto riscontrato in X1.2) -->
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Database\Database.csproj" />
  </ItemGroup>

</Project>
