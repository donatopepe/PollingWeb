<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PollingWeb.UnitTests — test unitari (task T1).

    Target net8.0 e non net48 perché i test devono essere ESEGUIBILI su Linux, macOS e
    Windows. Il runtime di .NET Framework non esiste fuori da Windows, quindi un progetto
    di test net48 si compilerebbe ma non si eseguirebbe in CI.

    Copre i tipi di `Database` e `PollingClass`, entrambi multi-target net48;net8.0.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>PollingWeb.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Database\Database.csproj" />
    <ProjectReference Include="..\..\PollingClass\PollingClass.csproj" />
    <PackageReference Include="Quartz" />
  </ItemGroup>

</Project>
